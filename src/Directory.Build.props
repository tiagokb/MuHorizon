<?xml version="1.0" encoding="utf-8"?>
<Project>

    <!-- In-container builds: redirect obj/ and bin/ to a Linux-native volume so that
         (a) Windows path fragments never land in project.assets.json, and
         (b) incremental build state survives container restarts. -->
    <PropertyGroup Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == 'true'">
        <BaseIntermediateOutputPath>/build-cache/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
        <BaseOutputPath>/build-cache/$(MSBuildProjectName)/bin/</BaseOutputPath>
    </PropertyGroup>

    <ItemGroup Label="commom configuration code style.">
        
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        
    </ItemGroup>

    <Choose>
        <When Condition="Exists('../SharedAssemblyInfo.cs')">
            <ItemGroup>
                <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
                <Compile Include="..\SharedGlobalUsings.cs" Link="SharedGlobalUsings.cs" />
                <None Include="..\.editorconfig" Link=".editorconfig" />
            </ItemGroup>
            <ItemGroup>
                <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <Compile Include="..\..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
                <Compile Include="..\..\SharedGlobalUsings.cs" Link="SharedGlobalUsings.cs" />
                <None Include="..\..\.editorconfig" Link=".editorconfig" />
            </ItemGroup>
            <ItemGroup>
                <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
            </ItemGroup>
        </Otherwise>
    </Choose>
</Project>